generator client {
  provider   = "prisma-client-js"
  engineType = "library" // for cloudeflare 
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model song {
  id                   String        @id @default(auto()) @map("_id") @db.ObjectId
  title                String
  content              String?
  lyrics               Json?
  lines                Json?
  isChords             Boolean?      @default(false)
  isTranslation        Boolean?      @default(false)
  language             LanguageType? @default(en)
  version              VersionType?  @default(version_4)
  key                  String?
  bpm                  String?
  time                 String?
  tempo                TempoType?
  image                String?
  video                String?
  videoId              String?
  audio                String?
  color                String?
  // SEO
  slug                 String?
  status               StatusType?   @default(PUBLISH)
  about                String?
  searchVariant        String[]
  searchVariantInTitle Boolean?      @default(false)
  keyword              String[]
  metaDescription      String?
  excerpt              String?

  view      Int?
  like      Int?


  author   author? @relation(fields: [authorId], references: [id])
  authorId String? @db.ObjectId

  creator   artist? @relation(fields: [creatorId], references: [id])
  creatorId String? @db.ObjectId

  season   season? @relation(fields: [seasonId], references: [id])
  seasonId String? @db.ObjectId

  channelId   String?  @db.ObjectId
  createdById String?  @db.ObjectId
  updatedById String? @db.ObjectId

  channel channel? @relation(fields: [channelId], references: [id])

  createdBy user? @relation("SongCreatedBy", fields: [createdById], references: [id])

  updatedBy user? @relation("SongUpdatedBy", fields: [updatedById], references: [id])

  genre     SongGenre[] // Explicit relation
  category  SongCategory[] // Explicit relation
  scripture SongScripture[] // Explicit relation
  album     SongAlbum[]
  credits   SongCredit[]
  artist    SongArtist[] // Explicit relation
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model artist {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  type         ArtistType? // <-- NEW: Enum to classify artist
  link         String?
  image        String?
  about        String?
  isVerified   Boolean?    @default(false)
  slug         String      @unique
  color        String?
  email        String?
  instagram    String?
  youtube      String?
  spotify      String?
  appleMusic   String?
  amazonMusic  String?
  youTubeMusic String?
  tidal        String?
  deezer       String?
  soundCloud   String?
  pandora      String?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  season       season[]
  song         SongArtist[] // Explicit relation
  creator      song[]
  album        ArtistAlbum[]

  artistEvents EventArtist[]
  // songCredits  SongCredit[]
  eventCredits EventCredit[]
}

model album {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  about       String?

  image String?
  video String?
  slug  String
  color String?

  song   SongAlbum[]
  artist ArtistAlbum[]

  channelId String @db.ObjectId

  channel channel @relation(fields: [channelId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model author {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  image     String
  about     String?
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  song      song[]
}

model category {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  image     String?
  about     String?
  color     String?
  slug      String?        @unique // ✅ UNIQUE URL
  catType   catType?       @default(theme)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  song      SongCategory[] // Explicit relation
}

enum catType {
  theme
  mood
  activity
  occasion
}

model channel {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  legacyArtistId String? @db.ObjectId
  title           String
  slug           String  @unique

  avatar String?
  banner String?
  color String?

  description String?

  type ChannelType?

  verified Boolean? @default(false)
  claimed  Boolean? @default(false)

  email String?
  website String?

  instagram   String?
  youtube     String?
  spotify     String?
  appleMusic  String?
  amazonMusic String?
  youtubeMusic String?
  soundCloud  String?
  deezer      String?
  tidal       String?
  pandora     String?


  createdById String?
  
  team ChannelTeam[]

  songs song[]
  // songs SongArtist[] // Explicit relation

  albums album[]

  playlists playlist[]

  events event[]

  followers ChannelFollower[]
  artistAlbums ArtistAlbum[]
  songArtists SongArtist[]
  SongCredit  SongCredit[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model event {
  id    String  @id @default(auto()) @map("_id") @db.ObjectId
  title String
  slug  String  @unique
  image String?
  video String?

  startDate DateTime?
  endDate   DateTime?

  venue        String?
  location     String?
  details      Json?
  registration String?
  link         String?
  color        String?
  about        String?
  status       StatusType    @default(DRAFT)
  artist       EventArtist[]
  credits      EventCredit[]

  channelId String @db.ObjectId

  createdById String @db.ObjectId

  channel channel @relation(fields: [channelId], references: [id])

  // createdBy user @relation(fields:[createdById], references:[id])
  createdBy user     @relation("UserCreatedEvents", fields: [createdById], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model genre {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  image     String
  color     String?
  about     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  song      SongGenre[] // Explicit relation
}

model playlist {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  title String

  slug  String @unique
  cover String

  description String?

  visibility PlaylistVisibility

  channelId String @db.ObjectId

  createdById String @db.ObjectId

  channel channel @relation(fields: [channelId], references: [id])

  // createdBy user @relation(fields:[createdById], references:[id])
  // createdBy user @relation ("UserCreatedEvents", fields: [createdById], references: [id])
  createdBy user @relation("UserCreatedPlaylists", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
}

model season {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  image     String
  slug      String
  color     String?
  about     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  artist    artist   @relation(fields: [artistId], references: [id])
  artistId  String   @db.ObjectId
  song      song[]
}

model scripture {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  image     String
  slug      String?
  color     String?
  about     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  song      SongScripture[] // Explicit relation
}

model submission {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  type SubmissionType

  status SubmissionStatus @default(PENDING)

  name  String?
  email String?

  title   String?
  subject String?
  message String?

  payload   Json?
  repliedAt DateTime?

  userId String? @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model user {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  username String?
  email    String  @unique
  password String

  verified      Boolean @default(false)
  emailVerified Boolean @default(false)

  role Role @default(USER)

  image   String?
  bio     String?
  phone   String?
  website String?

  isActive Boolean    @default(true)
  status   UserStatus @default(ACTIVE)

  channels ChannelTeam[]

  createdSongs song[] @relation("SongCreatedBy")
  updatedSongs song[] @relation("SongUpdatedBy")
  createdEvents event[] @relation("UserCreatedEvents")
  createdPlaylists playlist[] @relation("UserCreatedPlaylists")

  invitedMembers ChannelTeam[] @relation("InvitedBy")
  followedChannels ChannelFollower[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ENUM

enum ArtistType {
  individual
  band
  label
  channel
}

enum SongSectionType {
  INTRO
  VERSE
  PRE_CHORUS
  CHORUS
  POST_CHORUS
  BRIDGE
  INTERLUDE
  INSTRUMENTAL
  SOLO
  RAP
  TAG
  HOOK
  REFRAIN
  BREAKDOWN
  OUTRO
  ENDING
  SPOKEN
  ADLIB
  OTHER
}

enum VersionType {
  version_2
  version_3
  version_4
  version_5
}

enum StatusType {
  DRAFT
  REVIEW
  PUBLISH
  ARCHIVE
  UPCOMING
  CANCELLED
  COMPLETE
  TRASH
}

enum LanguageType {
  bn
  en
  es
  gu
  hi
  kn
  ml
  mr
  ne
  pa
  pt
  sa
  ta
  te
  ur
}

enum TempoType {
  largo // very slow
  adagio // slow
  andante // walking pace
  moderato // medium
  allegro // fast
  presto // very fast
}

enum CreditRole {
  ACTOR
  DIRECTOR
  PRODUCER

  SINGER
  WRITER
  COMPOSER
  PERFORMER

  ELECTRIC_GUITAR
  ACOUSTIC_GUITAR
  BASS
  DRUMS
  KEYBOARD

  ORGANIZER

  MIX_ENGINEER
  MASTERING_ENGINEER
  LEAD_VOCAL
  BACKING_VOCAL
  TRANSLATOR
  ARRANGER
  MUSIC_DIRECTOR

  BAND
  CREATOR
}

enum CreditDepartment {
  CAST
  CREW
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
  // EDITOR
  // AUTHOR
}

enum SubmissionType {
  SONG_REQUEST
  LYRICS_SUBMISSION
  SUGGESTION
  CONTACT
  ARTIST_REQUEST
  BUG_REPORT
}

enum SubmissionStatus {
  PENDING
  PROGRESS
  REVIEWING
  APPROVED
  REJECTED
  COMPLETED
}

enum ChannelType {
  PERSON
  CHURCH
  BAND
  MINISTRY
  CHOIR
  LABEL
  ORGANIZATION
}

enum MemberStatus {
  INVITED
  ACTIVE
  LEFT
  REMOVED
}

enum ChannelRole {
  OWNER
  ADMIN
  EDITOR
  CONTRIBUTOR
  VIEWER
}

enum PlaylistVisibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

// Intermediate table for Song  Artist and Role many-to-many

model ChannelFollower {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @db.ObjectId

  channelId String @db.ObjectId

  user user @relation(fields: [userId], references: [id])

  channel channel @relation(fields: [channelId], references: [id])

  @@unique([userId, channelId])
}

model ChannelInvitation {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  channelId String @db.ObjectId

  email String

  role ChannelRole

  token String @unique

  expiresAt DateTime

  acceptedAt DateTime?

  invitedById String @db.ObjectId
}

model ChannelClaim {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  channelId String @db.ObjectId

  requestedById String @db.ObjectId

  message String?

  status ClaimStatus

  reviewedById String? @db.ObjectId

  createdAt DateTime @default(now())
}


model ChannelTeam {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId    String @db.ObjectId
  channelId String @db.ObjectId

  role   ChannelRole
  status MemberStatus

  invitedById String? @db.ObjectId

  joinedAt DateTime @default(now())

  user      user    @relation(fields: [userId], references: [id])
  channel   channel @relation(fields: [channelId], references: [id])
  invitedBy user?   @relation("InvitedBy", fields: [invitedById], references: [id])

  @@unique([userId, channelId])
}

