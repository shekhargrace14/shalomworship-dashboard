model SongCredit {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  songId String @db.ObjectId
  channelId String @db.ObjectId

  role CreditRole

  song    song    @relation(fields: [songId], references: [id])
  channel channel @relation(fields: [channelId], references: [id])

  createdAt DateTime @default(now())

  @@unique([songId, channelId, role])
}

// Intermediate table for Event  Artist and Role many-to-many
model EventCredit {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  eventId  String @db.ObjectId
  artistId String @db.ObjectId

  department CreditDepartment
  role       CreditRole

  event  event  @relation(fields: [eventId], references: [id])
  artist artist @relation(fields: [artistId], references: [id])

  createdAt DateTime @default(now())
}

// Intermediate table for SongArtist many-to-many
model SongArtist {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  songId String @db.ObjectId

  artistId  String? @db.ObjectId // old
  channelId String? @db.ObjectId // new

  isCreator Boolean? @default(false)
  isArtist  Boolean? @default(true)

  song    song     @relation(fields: [songId], references: [id])
  artist  artist?   @relation(fields: [artistId], references: [id])  
  channel channel? @relation(fields: [channelId], references: [id])

  createdAt DateTime? @default(now())
}

// Intermediate table for song-genre many-to-many
model SongGenre {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  songId  String @db.ObjectId
  genreId String @db.ObjectId
  song    song   @relation(fields: [songId], references: [id])
  genre   genre  @relation(fields: [genreId], references: [id])
}

// Intermediate table SongCategory many-to-many
model SongCategory {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  songId     String   @db.ObjectId
  categoryId String   @db.ObjectId
  song       song     @relation(fields: [songId], references: [id])
  category   category @relation(fields: [categoryId], references: [id])
}

// Intermediate table for SongScripture many-to-many
model SongScripture {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  songId      String    @db.ObjectId
  scriptureId String    @db.ObjectId
  song        song      @relation(fields: [songId], references: [id])
  scripture   scripture @relation(fields: [scriptureId], references: [id])
}

model SongAlbum {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  songId  String @db.ObjectId
  albumId String @db.ObjectId
  song    song   @relation(fields: [songId], references: [id])
  album   album  @relation(fields: [albumId], references: [id])
}

model ArtistAlbum {
  id       String @id @default(auto()) @map("_id") @db.ObjectId

  artistId  String? @db.ObjectId
  channelId String? @db.ObjectId

  albumId  String @db.ObjectId

  artist  artist?  @relation(fields: [artistId], references: [id])
  channel channel? @relation(fields: [channelId], references: [id])
  
  album    album  @relation(fields: [albumId], references: [id])
}

model EventArtist {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  eventId  String? @db.ObjectId
  artistId String  @db.ObjectId
  event    event?  @relation(fields: [eventId], references: [id])
  artist   artist  @relation(fields: [artistId], references: [id])
}


model ArtistChannelMap {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  artistId  String @unique @db.ObjectId
  channelId String @unique @db.ObjectId
}



